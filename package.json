{
  "name": "vice",
  "version": "2.10.0",
  "private": true,
  "description": "Instant-replay clip recorder for Linux. Node deps are for UI design tooling only; the app itself is Python.",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/splitshotz/Vice.git"
  },
  "bugs": {
    "url": "https://github.com/splitshotz/Vice/issues"
  },
  "homepage": "https://github.com/splitshotz/Vice#readme",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "accents": "node --import ./tools/mcu-resolve.mjs tools/derive-accents.mjs",
    "accents:verify": "node tools/verify-custom-accent.mjs",
    "i18n:check": "node tools/check-locales.mjs",
    "i18n:new": "node tools/new-locale.mjs"
  },
  "dependencies": {
    "@astryxdesign/cli": "^0.4.1",
    "@astryxdesign/core": "^0.4.1",
    "@astryxdesign/theme-neutral": "^0.4.1",
    "@stylexjs/stylex": "^0.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@material/material-color-utilities": "^0.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
