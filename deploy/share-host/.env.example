PUBLIC_BASE_URL=https://gclips.kimonima.de
# Public Nextcloud origin, including /nextcloud when installed in a subfolder.
# An internal HTTP origin also works when reachable from the share container.
NEXTCLOUD_BASE_URL=
# Generate a private token with init_env.py. Do not use your Nextcloud password.
VICE_SHARE_API_TOKEN=
# Nextcloud 29+: dav. For an older installation, try download.
NEXTCLOUD_MEDIA_MODE=dav
LOCAL_PORT=8787
# Required only with compose.tunnel.yaml; use your existing network's name.
CLOUDFLARED_NETWORK=
